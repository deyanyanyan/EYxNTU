# =============================================================================
# lms-platform — environment configuration
# Copy to .env (run: python scripts/gen_env.py) and adjust. Never commit .env.
# Compose loads this file for interpolation; API/worker also receive it as env_file.
# See docs/ENVIRONMENT.md for what each variable does and which profile needs it.
# =============================================================================

# ---- Profile -----------------------------------------------------------------
# cpu = laptops (Ollama, CPU embeddings). Speech is optional: add profile media.
# gpu = NVIDIA Linux workstation (vLLM, CPU embeddings); hardware validation pending.
COMPOSE_PROFILES=cpu

# ---- Database (PostgreSQL + pgvector) ---------------------------------------
POSTGRES_USER=lms
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=lms
POSTGRES_PORT=5432
# The API and worker use this DSN. Inside compose the host is `postgres`;
# when running the API directly on your machine use `localhost`.
DATABASE_URL=postgresql+psycopg://lms:change-me-local-only@postgres:5432/lms

# ---- Auth --------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-run-scripts-gen_env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Bootstrap admin created on first API start if no users exist.
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change-me-on-first-login
DEFAULT_ADMIN_NAME=Platform Admin

# ---- LLM (any OpenAI-compatible server: vLLM, Ollama, llama.cpp) -----------
# cpu profile -> Ollama inside compose. gpu profile -> vLLM inside compose.
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=local-no-key-needed
LLM_MODEL=qwen2.5:7b-instruct
# vLLM gpu profile example (the client does not switch Qwen3.8's thinking off yet;
# see services/inference/README.md):
# LLM_BASE_URL=http://inference:8000/v1
# LLM_MODEL=Qwen/Qwen3.8-27B
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=300
# Context window the server is actually serving. Ollama defaults to 4096 and
# SILENTLY drops the oldest tokens above it, so retrieved evidence disappears
# with no error. Keep these two in step: OLLAMA_CONTEXT_LENGTH configures the
# server, LLM_CONTEXT_TOKENS lets the client refuse an oversized prompt first.
OLLAMA_CONTEXT_LENGTH=16384
LLM_CONTEXT_TOKENS=16384

# ---- Embeddings (sentence-transformers, runs inside the API/worker) ---------
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
# HuggingFace cache so weights are downloaded once and then work offline.
HF_HOME=/data/models/hf
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# ---- Retrieval ---------------------------------------------------------------
RAG_TOP_K=6
RAG_SIMILARITY_THRESHOLD=0.45
CHUNK_SIZE=1500
CHUNK_OVERLAP=300

# ---- TTS (OpenAI-compatible /v1/audio/speech) --------------------------------
TTS_BASE_URL=http://tts:8880/v1
TTS_VOICE=en_US-lessac-medium
TTS_ENGINE=piper

# ---- Storage -----------------------------------------------------------------
DATA_DIR=/data
MAX_UPLOAD_MB=200

# ---- API / Web ---------------------------------------------------------------
API_PORT=8000
WEB_PORT=3000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
LOG_LEVEL=INFO

# ---- Worker ------------------------------------------------------------------
WORKER_POLL_SECONDS=2
WORKER_MAX_JOB_MINUTES=120

# ---- Inference server (gpu profile only) ------------------------------------
# Base model: a hub id already in HF_HOME (the server runs offline), or a directory
# under /data/models. Pin VLLM_REVISION for hub ids; infra/models.lock.json records it.
# These are the released reviewer's base and revision (docs/MODELS.md).
VLLM_MODEL=Qwen/Qwen3.8-27B
VLLM_REVISION=1d4bf0f2ff6012fd82039f2fa52739d0dd7c60c0
# Hub id of the base when VLLM_MODEL is a directory (adapters are checked against it).
VLLM_BASE_ID=
VLLM_MAX_MODEL_LEN=32768
VLLM_GPU_MEMORY_UTILIZATION=0.90
# Custom LoRA adapters on top of VLLM_MODEL, as space-separated name=dir pairs; dirs
# are relative to data/models/adapters. Each name becomes a model the app can request,
# e.g. "generator=generator-v1 reviewer=reviewer-main-27b-v1". The server refuses to
# start if an adapter's serving.json names a different base model or revision.
VLLM_LORA_MODULES="reviewer=reviewer-main-27b-v1"
VLLM_MAX_LORAS=2
VLLM_MAX_LORA_RANK=16
VLLM_EXTRA_ARGS=

# ---- Reviewer (custom evaluator; separate from the generation model) ---------
# Off until a validated reviewer adapter is deployed (passes `make served-check`).
# Served by the gpu-profile inference container as the adapter named REVIEWER_MODEL.
REVIEWER_ENABLED=false
REVIEWER_BASE_URL=http://inference:8000/v1
REVIEWER_API_KEY=local-no-key-needed
REVIEWER_MODEL=reviewer
REVIEWER_MAX_TOKENS=768
REVIEWER_TIMEOUT_SECONDS=300
# The adapter was trained and evaluated on reviews that fit in 4K tokens. Longer reviews
# are split into scoped cases instead of being truncated, so the client refuses them.
REVIEWER_CONTEXT_TOKENS=8192
# Trained and evaluated with the chat template's thinking mode off.
REVIEWER_ENABLE_THINKING=false
